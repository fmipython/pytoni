# Copy to .env and fill in real values. .env is gitignored.

# Shared secret used to sign (bot) and verify (backend) the chat JWTs.
# Use a long random value; it must be identical on the Discord bot and the backend.
JWT_SECRET=

# OpenRouter API key used by the course manager agent.
OPENROUTER_API_KEY=

# Set to true for verbose per-request agent debug logs (model calls, tool calls, timing).
# AGNO_DEBUG_LEVEL=2 for more detail. No effect if unset/false.
AGNO_DEBUG=false
